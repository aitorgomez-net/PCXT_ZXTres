create_clock -period 20.000 -name clk50 [get_ports CLOCK_50]
# The DeMiSTify controller's SPI clock clocks the MiST interface registers
# (user_io, data_io, osd). Its fastest rate is well below 12.5 MHz.
create_generated_clock -name spiclk -source [get_ports CLOCK_50] -divide_by 4     [get_pins -hierarchical -filter {NAME =~ *controller/spi/sck_reg*/Q}]

# Clock domains of the guest, as the MiSTer core has them (SYSTEM.sdc):
#   - the system MMCM (u_sys_mmcm): the chipset clock (50 MHz) and the 8088
#     core clock (100 MHz), timed against each other and against the board
#     clock of the controller, from the same oscillator;
#   - the video MMCM (u_video_mmcm): the CGA dot clock (28.636 MHz), the video
#     pipeline (57.27 MHz) and the SDRAM and Hercules clock (114.5 MHz), with
#     the 14.318 MHz register clock derived from the first; synchronous to
#     each other, false paths to the system group as on MiSTer, where the
#     crossings have their own synchronisers (sdram_xbridge, the video I/O
#     handshakes of PERIPHERALS);
#   - the controller's SPI clock (MiST modules, OSD text memory).
set sys_clocks [get_clocks -of_objects [get_pins guest/u_sys_mmcm/CLKOUT*]]
set video_clocks [get_clocks -of_objects [get_pins guest/u_video_mmcm/CLKOUT*]]
create_generated_clock -name clk_14_318 -source [get_pins guest/u_video_mmcm/CLKOUT2] -divide_by 2 [get_pins guest/clk_14_318_reg/Q]
set_clock_groups -asynchronous -group [list [get_clocks clk50] $sys_clocks] -group [get_clocks spiclk]     -group [list $video_clocks [get_clocks clk_14_318]]
# The 27 MHz clock of the scan converter's output (u_scan_mmcm) is asynchronous
# to all the others: its line store, two toggles, the reset, the settings and
# the syncs measured by zxtres_vidinfo cross through synchronizers.
set scan_clocks [get_clocks -quiet -of_objects [get_pins -quiet -hierarchical -filter {NAME =~ guest/u_scan_mmcm/CLKOUT*}]]
set_clock_groups -asynchronous -group $scan_clocks     -group [list [get_clocks clk50] $sys_clocks [get_clocks spiclk] $video_clocks [get_clocks clk_14_318]]

# As in SYSTEM.sdc: the splash switch, and the configuration latched at reset
# on the falling chipset edge (machine model, PCjr RAM size, Hercules flag,
# video card), written only while the CPU is held in reset.
set_false_path -to [get_cells guest/splash_off_reg]
set_false_path -from [get_cells -quiet {guest/tandy_applied_r_reg guest/pcjr_applied_r_reg* guest/pcjr_ram_size_r_reg[*] guest/hgc_mode_reg guest/ega_active_r_reg*}]

set_false_path -to [get_ports {VGA_* LED SD_CS SD_SCK SD_MOSI PS2_* JOY_CLK JOY_LOAD JOY_SEL AUDIO_* I2S_*}]
set_false_path -from [get_ports {SD_MISO PS2_* JOY_DATA}]
# The SRAM is accessed on a two-clock protocol (zxtres_sram_ctrl.sv): the
# address is launched from a flip-flop on the 57 MHz clock and the data
# sampled 34.9 ns later, against 10 ns of access time.
set_false_path -to [get_ports {SRAM_*}]
set_false_path -from [get_ports {SRAM_Q[*]}]

# The SDRAM runs at 114.5 MHz (sdram_ctrl.sv): commands and data leave from
# registers on the controller clock and the chip clock is that clock
# inverted, from an output DDR register, so the chip samples them half a
# period later; read data is taken CL+1 clocks after the command, a cycle and
# a half after the chip has driven it. Put those registers in the I/O cells
# so the pin delays are the same for every bit.
set_property IOB TRUE [get_ports {SDRAM_A[*] SDRAM_BA[*] SDRAM_DQ[*] SDRAM_DQML SDRAM_DQMH SDRAM_nWE SDRAM_nCAS SDRAM_nRAS}]
# SDRAM_nCS is a constant 0 (every command of sdram_ctrl selects the chip): no flip-flop to pack.
